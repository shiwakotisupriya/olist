            "summarizeBy": "none"
          },
          {
            "name": "seller_state",
            "dataType": "string",
            "sourceColumn": "seller_state",
            "summarizeBy": "none"
          },
          {
            "name": "seller_label",
            "dataType": "string",
            "sourceColumn": "seller_label",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
