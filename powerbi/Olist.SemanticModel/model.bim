              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(\"A:/olist-delivery-analytics/data/processed/dim_seller.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    EmptyToNull = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),",
                "    Selected = Table.SelectColumns(EmptyToNull, {\"seller_id\", \"seller_state\", \"seller_label\"}),",
                "    Typed = Table.TransformColumnTypes(Selected, {{\"seller_id\", type text}, {\"seller_state\", type text}, {\"seller_label\", type text}}, \"en-US\")",
                "in",
